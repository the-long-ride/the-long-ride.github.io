---
import type { RepositoryMetadata } from "../../lib/github-metadata";
interface Props {
  role: string;
  stack: string[];
  status: "released" | "in-development";
  metadata?: RepositoryMetadata;
}
const { role, stack, status, metadata } = Astro.props;
---

<dl class="project-meta">
  <div>
    <dt>Role</dt>
    <dd>{role}</dd>
  </div>
  <div>
    <dt>Status</dt>
    <dd>
      {status === "released" && metadata?.latestRelease ? (
        <a
          href={metadata.latestRelease.url}
          target="_blank"
          rel="noreferrer"
          title={`View ${metadata.latestRelease.tag} on GitHub`}
        >
          {metadata.latestRelease.tag}
        </a>
      ) : status === "released" ? (
        "Released"
      ) : (
        "In development"
      )}
    </dd>
  </div>
  {metadata?.totalDownloads !== undefined && metadata.totalDownloads > 0 && (
    <div>
      <dt>Downloads</dt>
      <dd>
        <a
          href={`${metadata.url}/releases`}
          target="_blank"
          rel="noreferrer"
          title="View release downloads on GitHub"
        >
          {metadata.totalDownloads.toLocaleString()} assets
        </a>
      </dd>
    </div>
  )}
  <div>
    <dt>Stack</dt>
    <dd>{stack.join(" · ")}</dd>
  </div>
  {metadata?.primaryLanguage && (
    <div>
      <dt>Primary</dt>
      <dd>{metadata.primaryLanguage}</dd>
    </div>
  )}
</dl>
