---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeView from "../components/resume/ResumeView.astro";
import { resumeData, type ResumeData } from "../data/resume";
import { getResumeStaticPaths } from "../lib/resume";
import "../styles/sections/resume-print.css";
export function getStaticPaths() {
  return getResumeStaticPaths(resumeData);
}
interface Props {
  resume: ResumeData;
}
const { resume } = Astro.props;
---

<BaseLayout
  title={`Résumé — ${resume.identity.name}`}
  description={resume.summary}
  bodyClass="resume-document"
>
  <div class="page-shell resume-page">
    <div class="resume-actions">
      <a class="text-link" href="/resume.pdf">
        Download PDF <span aria-hidden="true">↓</span>
      </a>
    </div>
    <ResumeView data={resume} />
  </div>
</BaseLayout>
